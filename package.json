{
  "name": "scrape-ops",
  "version": "1.0.0",
  "description": "Scraping starter with Crawlee, Puppeteer, Axios, Cheerio, and SQLite",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "start:axios": "node src/main.js --engine=axios",
    "start:puppeteer": "node src/main.js --engine=puppeteer",
    "scrape:notes": "node src/main.js --url=https://www.fragrantica.com/notes/ --engine=puppeteer",
    "download:images": "node src/scripts/download-images.js",
    "inspect:notes": "node src/scripts/inspect-notes.js",
    "inspect:db": "node src/scripts/inspect-db.js"
  },
  "keywords": [
    "crawler",
    "scraper",
    "crawlee",
    "puppeteer",
    "cheerio",
    "axios",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.0.0",
    "crawlee": "^3.12.2",
    "dotenv": "^16.4.7",
    "puppeteer": "^24.1.1"
  }
}
