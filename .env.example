# Scraping Starter Configuration

# Fetch Engine: "axios" or "puppeteer"
FETCH_ENGINE=axios

# Target starting URL
TARGET_URL=https://www.fragrantica.com

# Crawlee Crawling limits
MAX_REQUESTS_PER_CRAWL=1
MAX_RETRIES=3
CONCURRENCY=1

# Storage
DATABASE_PATH=./data/scrapes.db

# Puppeteer Options
PUPPETEER_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=/opt/google/chrome/chrome

# HTTP Options
REQUEST_TIMEOUT_MS=30000

